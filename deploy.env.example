# Deploy configuration — copy this to deploy.env and fill in your values.
# deploy.env is gitignored and should NEVER be committed.
# This file (deploy.env.example) IS committed as a template.

# SSH target: user@server-ip
DEPLOY_SERVER=root@YOUR_SERVER_IP

# Remote directory where backend lives
DEPLOY_TARGET_DIR=/opt/uphill-ai-backend

# --- COROS watch integration ---
# These six belong in backend/.env on the server (see CLAUDE.md's
# "Environment Variables" section) -- listed here for operator visibility,
# since backend/.env has no committed example file of its own.

# Fernet key that encrypts COROS OAuth tokens at rest (COROS Agreement
# 11.2(c) requires encryption at rest). Generate it ONCE with:
#   python -c "from services.token_crypto import generate_key; print(generate_key())"
# then set it in backend/.env. Rotating it invalidates every already-stored
# token, forcing every athlete to reconnect their COROS account.
TOKEN_ENCRYPTION_KEY=

# OAuth client credentials issued by COROS's dynamic client registration --
# see backend/scripts/register_coros_client.py.
COROS_CLIENT_ID=
COROS_CLIENT_SECRET=

# Must exactly match the redirect URI registered with COROS.
COROS_REDIRECT_URI=https://your-api-domain/api/integrations/coros/callback

# COROS MCP server endpoint polled for activities and health data.
COROS_MCP_ENDPOINT=https://mcp.coros.com/mcp

# Frontend origin the OAuth callback redirects the athlete's browser back to
# after connect/error.
FRONTEND_URL=https://your-frontend-domain

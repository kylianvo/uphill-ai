    "Runs, hikes and strength sessions from your iPhone, Apple Watch or any app that saves to Health.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Buổi chạy, hike và buổi Strength từ iPhone, Apple Watch hoặc app nào lưu vào Health."
          }

          "stringUnit": {
            "state": "translated",
            "value": "Liên kết hồ sơ UTMB hoặc VBM"
          }
        }
      }
    },
    "Link your UTMB profile for your UTMB index": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liên kết hồ sơ UTMB để có UTMB index"
          }
        }
      }
    },
    "Matched race": {

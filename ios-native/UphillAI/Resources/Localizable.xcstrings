          }
        }
      }
    },
    "No running yet": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa chạy bộ"
          }
        }
      }
    },
    "Start at least 2 weeks before your goal date.": {
      "localizations": {

      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tôi đọc gì"
          }
        }
      }
    },
    "Runs, hikes, stair sessions and strength workouts from the last 12 weeks, then each new one as it's saved.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Buổi chạy, hike, leo cầu thang và Strength trong 12 tuần gần nhất, sau đó là từng buổi mới ngay khi được lưu."
          }

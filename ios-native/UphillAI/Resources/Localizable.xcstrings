    "Source: %@": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nguồn: %@"
          }
        }
      }
    },
    "The pace you hold at your aerobic threshold heart rate on easy runs. Getting faster at the same heart rate means your aerobic base is growing.": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pace bạn giữ được ở nhịp tim AeT trong các buổi Easy Run. Nhanh hơn ở cùng nhịp tim nghĩa là nền Aerobic đang tăng."
          }
        }
      }
    },
    "Training load": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Training load"
          }
        }
      }
    },
    "Training load appears after 28 days of data": {
      "localizations": {
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Training load hiện sau 28 ngày có dữ liệu"
          }
        }
      }
    },
    "Volume & climb": {
      "localizations": {
        "vi": {
          "stringUnit": {

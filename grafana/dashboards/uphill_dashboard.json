{
  "uid": "uphill-ai-main",
  "title": "Uphill AI Observability",
  "schemaVersion": 38,
  "refresh": "10s",
  "panels": [
    {
      "type": "stat",
      "title": "API Traffic (Count & RPS)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(http_requests_total)",
          "legendFormat": "Total Requests"
        },
        {
          "expr": "sum(rate(http_requests_total[5m]))",
          "legendFormat": "Current RPS (5m)"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Avg RAG Latency (Gemini)",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(rate(rag_latency_seconds_sum{engine=\"gemini\"}[5m])) / sum(rate(rag_latency_seconds_count{engine=\"gemini\"}[5m]))",
          "legendFormat": "Gemini Avg Latency (5m)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "API Traffic (RPS)",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[1m])) by (method, handler)",
          "legendFormat": "{{method}} {{handler}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "RAG Latency by Service (Gemini)",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "rate(rag_latency_seconds_sum{engine=\"gemini\"}[1m]) / rate(rag_latency_seconds_count{engine=\"gemini\"}[1m])",
          "legendFormat": "{{service}} Avg Latency"
        }
      ]
    },
    {
      "type": "stat",
      "title": "RAG Success Rate (Gemini)",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "100 * sum(rag_attempts_total{engine=\"gemini\", status=\"success\"}) / sum(rag_attempts_total{engine=\"gemini\", status=\"attempt\"})",
          "legendFormat": "Success Rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "max": 100,
          "min": 0
        }
      }
    },
    {
      "type": "stat",
      "title": "NotebookLM Fallback Uses",
      "gridPos": {
        "x": 6,
        "y": 12,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(rag_attempts_total{engine=\"notebooklm\"})",
          "legendFormat": "Fallback Invocations"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "RAG Attempts & Errors by Service (rate)",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(rag_attempts_total{engine=\"gemini\", status=\"attempt\"}[1m])) by (service)",
          "legendFormat": "{{service}} Gemini Attempts"
        },
        {
          "expr": "sum(rate(rag_attempts_total{status=\"error\"}[1m])) by (service, engine)",
          "legendFormat": "{{service}} {{engine}} Errors"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Node CPU Usage",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode='idle'}[1m])) * 100)",
          "legendFormat": "CPU %"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Node Memory Usage",
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "(node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes) / node_memory_MemTotal_bytes * 100",
          "legendFormat": "Memory %"
        }
      ]
    },
    {
      "title": "RAG Attempts by Engine & Status",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 4
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rag_attempts_total{engine=\"gemini\", status=\"success\"})",
          "legendFormat": "Gemini Success",
          "refId": "A"
        },
        {
          "expr": "sum(rag_attempts_total{engine=\"gemini\", status=\"error\"})",
          "legendFormat": "Gemini Error",
          "refId": "B"
        },
        {
          "expr": "sum(rag_attempts_total{engine=\"notebooklm\"})",
          "legendFormat": "NotebookLM Fallback",
          "refId": "C"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "type": "logs",
      "title": "Gemini / NotebookLM Errors (live)",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessages": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "expr": "{container=~\".*-backend-[0-9]+\", status=\"error\"}",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "RAG Error Rate by Service (from logs)",
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "sum(count_over_time({container=~\".*-backend-[0-9]+\", status=\"error\"}[5m])) by (service)",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ]
    },
    {
      "type": "logs",
      "title": "Gemini Prompt/Response Activity (live)",
      "gridPos": {
        "x": 12,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessages": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "expr": "{container=~\".*-backend-[0-9]+\", engine=\"gemini\"}",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ]
    }
  ]
}

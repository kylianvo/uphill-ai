    {
      "type": "text",
      "id": "code_minetti_title",
      "x": 895,
      "y": 318,
      "width": 237,
      "height": 14,
      "text": "EVIDENCE: Minetti (2002) Energy Cost",
      "originalText": "EVIDENCE: Minetti (2002) Energy Cost",
      "fontSize": 11,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#38bdf8",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,

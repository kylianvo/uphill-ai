    },
    {
      "type": "text",
      "id": "code_minetti_body",
      "x": 895,
      "y": 336,
      "width": 258,
      "height": 78,
      "text": "def minetti_cost(gradient: float) -> float:\n  i = gradient # e.g. 0.15 for 15%\n  # J/kg/m metabolic energy cost\n  cr = (155.4*i**5 - 30.4*i**4 - 43.3*i**3\n        + 46.3*i**2 + 19.5*i + 3.6)\n  return max(cr, 1.8) # Downhill floor",
      "originalText": "def minetti_cost(gradient: float) -> float:\n  i = gradient # e.g. 0.15 for 15%\n  # J/kg/m metabolic energy cost\n  cr = (155.4*i**5 - 30.4*i**4 - 43.3*i**3\n        + 46.3*i**2 + 19.5*i + 3.6)\n  return max(cr, 1.8) # Downhill floor",
      "fontSize": 10,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#f472b6",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "angle": 0,
      "seed": 30087,
      "version": 1,
